# Skutečný klíč patří do NEcommitovaného .env.local (viz .gitignore), nikdy
# sem. Bez klíče hra běží plně na fallback šablonách (ADR-004) — klíč je
# volitelný, ne podmínka hratelnosti.
VITE_ANTHROPIC_API_KEY=

# Dev override: cesta k lokálnímu checkoutu design repa (živé ladění obsahu).
# Nenastaveno = čte se kořen monorepa (../obsah).
# CONTENT_DIR=C:\Projekty\Case files
